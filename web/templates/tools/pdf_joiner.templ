package tools

import "github.com/tmunongo/nanotools/web/templates"

templ PDFJoinerPage() {
@templates.Layout("PDF Joiner") {
<div class="tool-page" x-data="pdfJoiner()">
    <div class="tool-header">
        <div class="tool-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 2.5rem; height: 2.5rem;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
        </div>
        <h2>PDF Joiner</h2>
        <p class="tool-description">
            Merge multiple PDF files into one document. Drag and drop to reorder.
        </p>
    </div>

    <div class="tool-content" style="max-width: 800px; margin: 0 auto;">
        <!-- Instructions -->
        <div class="tool-instructions" style="background: #f3f4f6; padding: 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem;">
            <h3 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.1rem; color: #111827;">How to use</h3>
            <ol style="margin: 0; padding-left: 1.5rem; color: #4b5563; line-height: 1.6;">
                <li>Click <strong>Upload PDFs</strong> to select the files you want to merge.</li>
                <li>Verify the order of files in the list below. Use the up/down arrows to reorder them.</li>
                <li>Click <strong>Join PDFs</strong> to download your merged document.</li>
            </ol>
        </div>

        <div class="tool-form">
            <form @submit.prevent="join" enctype="multipart/form-data">
                <div class="form-section">
                    <label class="form-label">
                        <span class="label-dot"></span>
                        Upload PDFs
                    </label>
                    <input type="file" @change="handleFileSelect" accept=".pdf" multiple class="file-input" />
                    <p class="help-text">Select multiple files. Max size per file: 50MB</p>
                </div>

                <!-- File List with Reordering -->
                <div class="form-section" x-show="files.length > 0">
                    <label class="form-label">Selected Files (In Order)</label>
                    <div class="file-list" style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <template x-for="(file, index) in files" :key="file.id">
                            <div class="file-item" style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
                                    <span x-text="index + 1" style="font-weight: bold; color: #6b7280; margin-right: 0.5rem;"></span>
                                    <div class="file-icon" style="color: #6b7280;">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.25rem; height: 1.25rem;">
                                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                        </svg>
                                    </div>
                                    <div class="file-details">
                                        <p class="file-name" x-text="file.name" style="font-weight: 500;"></p>
                                        <p class="file-size" x-text="file.size" style="font-size: 0.75rem; color: #6b7280;"></p>
                                    </div>
                                </div>
                                
                                <div class="file-actions" style="display: flex; gap: 0.25rem;">
                                    <button type="button" @click="moveUp(index)" :disabled="index === 0" class="btn-icon" style="padding: 0.25rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.25rem; height: 1.25rem;">
                                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
                                        </svg>
                                    </button>
                                    <button type="button" @click="moveDown(index)" :disabled="index === files.length - 1" class="btn-icon" style="padding: 0.25rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.25rem; height: 1.25rem;">
                                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                        </svg>
                                    </button>
                                    <button type="button" @click="removeFile(index)" class="btn-icon" style="padding: 0.25rem; color: #ef4444;">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.25rem; height: 1.25rem;">
                                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-full" :disabled="joining || files.length < 2">
                        <span x-show="!joining">Join PDFs</span>
                        <span x-show="joining" class="loading" style="display: none;">
                            <span class="spinner"></span>
                            Joining...
                        </span>
                    </button>
                </div>
            </form>

            <div x-show="error" class="error-message" x-text="error" style="display: none;"></div>
        </div>
    </div>

    <div class="info-box info-box-info" style="max-width: 800px; margin: 2rem auto 0 auto;">
        <div class="info-box-header">
            <div class="info-box-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.5rem; height: 1.5rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
            </div>
            <h4 class="info-box-title">Privacy First</h4>
        </div>
        <p>
            Your PDFs are processed entirely on your server. Nothing is sent to third parties,
            and temporary files are deleted immediately after merging.
        </p>
    </div>
</div>
}
}
