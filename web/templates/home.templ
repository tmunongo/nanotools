package templates

templ HomePage() {
@Layout("Home") {
<div>
    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <div class="hero-inner">
                <div class="hero-content">
                    <p class="hero-eyebrow">Privacy-first utilities</p>
                    <h1 class="hero-title">Small tools.<br/>No nonsense.</h1>
                    <p class="hero-subtitle">
                        A collection of focused web utilities. All processing happens server-side.
                        Nothing is stored. Nothing is tracked.
                    </p>
                    <div class="hero-meta">
                        <div class="hero-meta-item">
                            <span class="hero-meta-value">10+</span>
                            <span class="hero-meta-label">Tools</span>
                        </div>
                        <div class="hero-meta-divider"></div>
                        <div class="hero-meta-item">
                            <span class="hero-meta-value">0</span>
                            <span class="hero-meta-label">Trackers</span>
                        </div>
                        <div class="hero-meta-divider"></div>
                        <div class="hero-meta-item">
                            <span class="hero-meta-value">100%</span>
                            <span class="hero-meta-label">Open source</span>
                        </div>
                    </div>
                </div>

                <!-- Right-side quick index -->
                <div class="hero-side">
                    <p class="hero-index-label">All tools</p>
                    <ul class="hero-tool-index">
                        <li><a href="/tools/video-to-gif">Video to GIF <span>Media</span></a></li>
                        <li><a href="/tools/video-downloader">Video Downloader <span>Media</span></a></li>
                        <li><a href="/tools/qr-code">QR Code Generator <span>Sharing</span></a></li>
                        <li><a href="/tools/image-converter">Image Converter <span>Image</span></a></li>
                        <li><a href="/tools/image-compressor">Image Compressor <span>Image</span></a></li>
                        <li><a href="/tools/pdf-to-images">PDF to Images <span>Document</span></a></li>
                        <li><a href="/tools/pdf-joiner">PDF Joiner <span>Document</span></a></li>
                        <li><a href="/tools/pdf-unlocker">PDF Unlocker <span>Document</span></a></li>
                        <li><a href="/tools/json-formatter">JSON Formatter <span>Text</span></a></li>
                        <li><a href="/tools/base64">Base64 Encoder <span>Text</span></a></li>
                        <li><a href="/tools/uuid">UUID Generator <span>Text</span></a></li>
                        <li><a href="/tools/slugify">Slugify <span>Text</span></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Media Tools -->
    <section class="category-section" id="tools">
        <div class="container">
            <div class="category-header">
                <h2 class="category-title">Media</h2>
                <p class="category-description">Video and animated content</p>
            </div>
            <div class="tools-category-grid">
                <a href="/tools/video-to-gif" class="tool-card-enhanced">
                    <h3 class="tool-card-title">Video to GIF</h3>
                    <p class="tool-card-description">Convert video clips to optimised, high-quality GIFs</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Convert</span>
                        <span class="tool-tag">Optimise</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/video-downloader" class="tool-card-enhanced">
                    <h3 class="tool-card-title">Video Downloader</h3>
                    <p class="tool-card-description">Download videos from 1000+ sites for offline viewing</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">YouTube</span>
                        <span class="tool-tag">Educational</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>
            </div>
        </div>
    </section>

    <!-- QR & Sharing -->
    <section class="category-section">
        <div class="container">
            <div class="category-header">
                <h2 class="category-title">QR & Sharing</h2>
                <p class="category-description">Scannable codes and shareable content</p>
            </div>
            <div class="tools-category-grid">
                <a href="/tools/qr-code" class="tool-card-enhanced">
                    <h3 class="tool-card-title">QR Code Generator</h3>
                    <p class="tool-card-description">Create QR codes for URLs, Wi-Fi, contacts, and more</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">QR</span>
                        <span class="tool-tag">Wi-Fi</span>
                        <span class="tool-tag">vCard</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Image Tools -->
    <section class="category-section">
        <div class="container">
            <div class="category-header">
                <h2 class="category-title">Images</h2>
                <p class="category-description">Convert, compress, and optimise images</p>
            </div>
            <div class="tools-category-grid">
                <a href="/tools/image-converter" class="tool-card-enhanced">
                    <h3 class="tool-card-title">Image Converter</h3>
                    <p class="tool-card-description">Convert between JPEG, PNG, and WebP with quality control</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Convert</span>
                        <span class="tool-tag">WebP</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/image-compressor" class="tool-card-enhanced">
                    <h3 class="tool-card-title">Image Compressor</h3>
                    <p class="tool-card-description">Reduce image file sizes without sacrificing quality</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Compress</span>
                        <span class="tool-tag">Optimise</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Document Tools -->
    <section class="category-section">
        <div class="container">
            <div class="category-header">
                <h2 class="category-title">Documents</h2>
                <p class="category-description">Process and convert PDFs</p>
            </div>
            <div class="tools-category-grid">
                <a href="/tools/pdf-to-images" class="tool-card-enhanced">
                    <h3 class="tool-card-title">PDF to Images</h3>
                    <p class="tool-card-description">Extract pages from PDFs as high-quality images</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Extract</span>
                        <span class="tool-tag">Convert</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/pdf-joiner" class="tool-card-enhanced">
                    <h3 class="tool-card-title">PDF Joiner</h3>
                    <p class="tool-card-description">Merge multiple PDF files into one document</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Merge</span>
                        <span class="tool-tag">Join</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/pdf-unlocker" class="tool-card-enhanced">
                    <h3 class="tool-card-title">PDF Unlocker</h3>
                    <p class="tool-card-description">Remove password protection from encrypted PDFs</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Decrypt</span>
                        <span class="tool-tag">Unlock</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Text Tools -->
    <section class="category-section">
        <div class="container">
            <div class="category-header">
                <h2 class="category-title">Text</h2>
                <p class="category-description">Format, encode, and transform text</p>
            </div>
            <div class="tools-category-grid">
                <a href="/tools/json-formatter" class="tool-card-enhanced">
                    <h3 class="tool-card-title">JSON Formatter</h3>
                    <p class="tool-card-description">Format and validate JSON with syntax highlighting and live feedback</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Format</span>
                        <span class="tool-tag">Validate</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/base64" class="tool-card-enhanced">
                    <h3 class="tool-card-title">Base64 Encoder</h3>
                    <p class="tool-card-description">Encode and decode Base64 strings for data URIs and APIs</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Encode</span>
                        <span class="tool-tag">Decode</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/uuid" class="tool-card-enhanced">
                    <h3 class="tool-card-title">UUID Generator</h3>
                    <p class="tool-card-description">Generate random UUIDs (v4) for databases and unique identifiers</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">Generate</span>
                        <span class="tool-tag">Bulk</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>

                <a href="/tools/slugify" class="tool-card-enhanced">
                    <h3 class="tool-card-title">Slugify</h3>
                    <p class="tool-card-description">Convert text to URL-friendly slugs with smart transliteration</p>
                    <div class="tool-card-tags">
                        <span class="tool-tag">URLs</span>
                        <span class="tool-tag">Clean</span>
                    </div>
                    <span class="tool-card-link">Open →</span>
                </a>
            </div>
        </div>
    </section>
</div>
}
}
